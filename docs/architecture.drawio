<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="810"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g2" value="Azure Databricks workspace  -  Unity Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F6FB5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontColor=#1F6FB5;" vertex="1" parent="1"><mxGeometry x="285" y="70" width="1180" height="415" as="geometry"/></mxCell><mxCell id="g3" value="Offline on a local machine (not connected to the workspace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C77700;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontColor=#C77700;" vertex="1" parent="1"><mxGeometry x="15" y="505" width="810" height="170" as="geometry"/></mxCell><mxCell id="csv" value="&lt;b&gt;Four Divvy CSV files&lt;/b&gt;&lt;br&gt;riders, payments, stations, trips&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;no header row; ~4.6M trips&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="vol" value="&lt;b&gt;Unity Catalog volume&lt;/b&gt;&lt;br&gt;/Volumes/.../raw&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;CSV files are never modified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b&gt;PySpark ingestion&lt;/b&gt;&lt;br&gt;explicit string schema + try_cast&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;parse failures counted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="bfile" value="&lt;b&gt;Bronze Delta files&lt;/b&gt;&lt;br&gt;volume /bronze_delta/&lt;entity&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;overwrite, row counts checked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="btab" value="&lt;b&gt;Bronze Delta tables&lt;/b&gt;&lt;br&gt;divvy_bronze.* (managed)&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;CREATE + INSERT OVERWRITE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="220" height="92" as="geometry"/></mxCell><mxCell id="xf" value="&lt;b&gt;PySpark transformations&lt;/b&gt;&lt;br&gt;dedupe, surrogate keys, joins&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;age, duration_quality, date keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1120" y="305" width="220" height="92" as="geometry"/></mxCell><mxCell id="gold" value="&lt;b&gt;Gold Delta star schema&lt;/b&gt;&lt;br&gt;divvy_gold: 3 dims + 2 facts&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;saveAsTable, mode overwrite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="850" y="305" width="220" height="92" as="geometry"/></mxCell><mxCell id="sql" value="&lt;b&gt;Spark SQL analytics&lt;/b&gt;&lt;br&gt;ride time, stations, payments&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;spend vs riding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="220" height="92" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;Data validation&lt;/b&gt;&lt;br&gt;assertions + diagnostics&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;counts, keys, amounts, rebuild&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FB;strokeColor=#1F6FB5;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="220" height="92" as="geometry"/></mxCell><mxCell id="exp" value="&lt;b&gt;Local rebuild + export&lt;/b&gt;&lt;br&gt;same code on Spark + Delta, laptop&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;summary tables only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#C77700;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="580" y="545" width="220" height="92" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Static dashboard&lt;/b&gt;&lt;br&gt;dashboard/index.html&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;data embedded, no backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#C77700;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="310" y="545" width="220" height="92" as="geometry"/></mxCell><mxCell id="pages" value="&lt;b&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;free static hosting&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;status: see README&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#C77700;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="220" height="92" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="csv" target="vol"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="vol" target="ing"><mxGeometr